{
  "name": "@fabric/ui",
  "version": "0.0.1",
  "description": "Shared UI component library — shadcn/ui (slate base, CSS variables)",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/index.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:visual": "playwright test src/e2e/visual-regression.e2e.ts",
    "test:e2e:a11y": "playwright test src/e2e/accessibility.e2e.ts",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.52.0",
    "http-server": "^14.1.1",
    "@storybook/addon-vitest": "^9.1.19",
    "@storybook/react-vite": "^9.1.19",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-istanbul": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0-rc.1",
    "storybook": "^9.1.19",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3"
  },
  "engines": {
    "bun": ">=1.2.0",
    "npm": "bun-is-our-jam",
    "yarn": "bun-is-our-jam",
    "pnpm": "bun-is-our-jam"
  },
  "packageManager": "bun@1.2.22",
  "license": "MIT"
}
