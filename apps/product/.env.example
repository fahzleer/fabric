PORT=4006

# CORS — restrict to gateway and web origins
GATEWAY_URL=http://localhost:4000

# Internal service secret — used to protect /products/:id/reserve (called by order service)
INTERNAL_SECRET=change-me-to-a-random-secret

# Database — product service owns fabric_products
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fabric_products

# Kafka (optional — falls back to no-op in dev)
KAFKA_BROKERS=localhost:9092

# OpenTelemetry
# OTEL_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
