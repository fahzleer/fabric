PORT=4004

# CORS — restrict to gateway and web origins
GATEWAY_URL=http://localhost:4000

# Database — shipping service owns fabric_shipments
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fabric_shipments

# Kafka — required for consuming order.paid events
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=fabric-shipping

# OpenTelemetry
# OTEL_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
