PASETO_KEY=

INTERNAL_SECRET=

# Firebase vars (FIREBASE_*, GOOGLE_*) are reserved — put them in .env.local so
# Firebase CLI doesn't try to deploy them as function env vars. Copy the lines below
# into .env.local (git-ignored, read by Bun but ignored by Firebase CLI):
#
#   FIREBASE_PROJECT_ID=demo-fabric-local
#   FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-fabric-local
#   FIREBASE_STORAGE_BUCKET=demo-fabric-local.appspot.com
#   FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
#   FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

EVENTS_SERVICE_URL=http://localhost:8082
COMMERCE_SERVICE_URL=http://localhost:8082
PRICING_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8082

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

STRIPE_PORTAL_RETURN_URL=

CORS_ORIGIN=http://localhost:3000

MEMCACHED_SERVERS=

GOOGLE_CLIENT_ID=

