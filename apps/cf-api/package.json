{
  "name": "cf-api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --hot run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "deploy": "firebase deploy --only functions:cfApi"
  },
  "dependencies": {
    "@fabric/cache": "*",
    "@fabric/firebase": "*",
    "@fabric/types": "*",
    "@fabric/contract": "*",
    "@fabric/orpc": "*",
    "@js-temporal/polyfill": "^0.5.1",
    "@orpc/server": "^1.13.5",
    "@orpc/openapi": "^1.13.5",
    "arktype": "^2.1.23",
    "bcryptjs": "^3.0.2",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.2",
    "hono": "^4.7.0",
    "paseto": "^3.1.4",
    "effect": "^3.17.13",
    "better-result": "^2.7.0",
    "bignumber.js": "^9.1.2",
    "@google-cloud/secret-manager": "^6.0.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.3.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0",
    "npm": "bun-is-our-jam",
    "yarn": "bun-is-our-jam",
    "pnpm": "bun-is-our-jam"
  },
  "packageManager": "bun@1.2.22",
  "license": "MIT"
}
