PORT=4000

# CORS — comma-separated list of origins allowed to call the gateway
# In production: set to your actual frontend domain(s)
ALLOWED_ORIGINS=http://localhost:3000

# Redis — used for distributed rate limiting
REDIS_URL=redis://localhost:6379

# OpenTelemetry — set to disable tracing in dev
# OTEL_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
