PORT=4005

# CORS — restrict to gateway and web origins
GATEWAY_URL=http://localhost:4000

# Kafka — required for consuming order/payment/shipment/customer events
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=fabric-notification

# SendGrid — email notifications (leave blank to use console.log in dev)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# Twilio — SMS notifications (leave blank to use console.log in dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase Cloud Messaging — push notifications (leave blank to use console.log in dev)
# Provide the full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=

# OpenTelemetry
# OTEL_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
