PORT=4002

# CORS — restrict to gateway and web origins
GATEWAY_URL=http://localhost:4000

# Token bridge — must match TOKEN_ISSUE_SECRET in apps/web
TOKEN_ISSUE_SECRET=change-me-to-a-random-secret

# Internal service secret — used for /internal/issue-token endpoint
INTERNAL_SECRET=change-me-to-a-random-secret

# Database — customer service owns fabric_customers
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fabric_customers

# Downstream services
PRODUCT_URL=http://localhost:4006
ORDER_URL=http://localhost:4001
PAYMENT_URL=http://localhost:4003

# Kafka (optional)
KAFKA_BROKERS=localhost:9092

# OpenTelemetry
# OTEL_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
