{
  "name": "cf-commerce",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --hot run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node && bun scripts/deploy-pkg.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "deploy": "firebase deploy --only functions:cf-commerce:cfCommerce"
  },
  "dependencies": {
    "@fabric/cache": "*",
    "@fabric/config": "*",
    "@fabric/firebase": "*",
    "@fabric/middleware": "*",
    "@fabric/types": "*",
    "@js-temporal/polyfill": "^0.5.1",
    "arktype": "^2.1.23",
    "better-result": "^2.7.0",
    "effect": "^3.17.13",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.2",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0",
    "npm": "bun-is-our-jam",
    "yarn": "bun-is-our-jam",
    "pnpm": "bun-is-our-jam"
  },
  "packageManager": "bun@1.2.22",
  "license": "MIT"
}
