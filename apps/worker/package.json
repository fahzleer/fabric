{
  "name": "worker",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run build:all && bun --hot run src/server.ts",
    "build:css": "vite build --config vite.tailwind.config.ts",
    "build:js": "bun run build.ts",
    "build:all": "bun run build:css && bun run build:js",
    "start": "bun run build:all && bun run src/server.ts",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format ./src --write"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/bun": "^1.3.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tailwindcss": "^4.1.16",
    "vite": "^7.1.12"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@elysiajs/static": "^1.4.4",
    "@fabric/types": "*",
    "@fabric/ui": "*",
    "@js-temporal/polyfill": "^0.5.1",
    "@sinclair/typebox": "^0.34.15",
    "arkregex": "^0.0.5",
    "arktype": "^2.1.23",
    "better-result": "^2.7.0",
    "elysia": "^1.4.25",
    "nuqs": "^2.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "npm": "bun-is-our-jam",
    "yarn": "bun-is-our-jam",
    "pnpm": "bun-is-our-jam"
  },
  "packageManager": "bun@1.2.22",
  "license": "MIT",
  "version": "0.0.1"
}
