PORT=4001

# CORS — restrict to gateway and web origins
GATEWAY_URL=http://localhost:4000

# Database — order service owns fabric_orders
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fabric_orders

# Kafka — required for transactional outbox fan-out and payment.succeeded consumer
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=fabric-order

# OpenTelemetry
# OTEL_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
