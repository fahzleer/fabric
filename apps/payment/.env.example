PORT=4003

# CORS — restrict to gateway and web origins
GATEWAY_URL=http://localhost:4000

# Downstream services
ORDER_URL=http://localhost:4001

# Database — payment service owns fabric_payments
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fabric_payments

# Kafka (optional — falls back to no-op in dev)
KAFKA_BROKERS=localhost:9092

# Omise credentials (leave blank to use stubs in dev)
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=

# OpenTelemetry
# OTEL_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
