PORT=4007

# CORS — restrict to gateway and web origins
GATEWAY_URL=http://localhost:4000

# Product database — search service reads from fabric_products (read-only connection)
PRODUCT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fabric_products

# Kafka
KAFKA_BROKERS=localhost:9092

# OpenTelemetry
# OTEL_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
