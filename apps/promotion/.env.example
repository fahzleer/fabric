PORT=4008

# CORS — restrict to gateway and web origins
GATEWAY_URL=http://localhost:4000

# Database — promotion service owns fabric_promotions
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fabric_promotions

# Kafka (optional — falls back to no-op in dev)
KAFKA_BROKERS=localhost:9092

# OpenTelemetry
# OTEL_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
